# ─── Future Voices — server configuration ─────────────────────────
# Copy this file to `.env` and adjust. Everything below is optional
# except DATABASE_URL on some hosts; the app runs fine with defaults.

# SQLite database file (created automatically by `npm run db:push`).
# Keep it on a persistent volume/disk and back it up.
# NOTE: relative SQLite paths are resolved from prisma/schema.prisma,
# so "../db/custom.db" means "<project>/db/custom.db".
DATABASE_URL="file:../db/custom.db"

# Where uploaded media is stored. Must be a writable, persistent path.
# Default: ./uploads next to the project.
# UPLOAD_DIR="/var/lib/future-voices/uploads"

# Public URL of your site — used in verification / reset emails.
# Example: https://capsules.yourdomain.com
# APP_URL="http://localhost:3000"

# ── Email (SMTP) ──────────────────────────────────────────────────

# Cloudflare-hosted installs CANNOT use SMTP (Workers block raw mail ports).
# There, use one of the HTTP providers instead — both have free tiers:
#
#   Resend  (resend.com, 3,000 emails/month)  → verify a domain you own, then:
# RESEND_API_KEY="re_xxxxxxxx"
#
#   Brevo   (brevo.com, 300 emails/day)       → verify your sender email, then:
# BREVO_API_KEY="xkeysib-xxxxxxxx"
#
# MAIL_FROM="Future Voices <capsule@yourdomain.com>"   (required with the above)
#
# Self-hosted installs can use classic SMTP below (or the HTTP providers too):
# Configure these to send real verification & password-reset emails.
# Any provider works (Gmail with an App Password, Postmark, SES,
# Resend, Mailgun, your own mail server…). Without them the app still
# works — the links are shown in the interface instead of emailed.
# SMTP_HOST="smtp.resend.com"   # or smtp-relay.brevo.com
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="resend"
# SMTP_PASS="your-app-password"
# MAIL_FROM="Future Voices <hello@yourdomain.com>"

# Optional shared secret for the /api/cron endpoint (external scheduler).
# When set, calls must include ?key=<CRON_SECRET>.
# CRON_SECRET="a-long-random-string"

# ── Magic keys & signed grants ────────────────────────────────────
# App-wide secret used to fingerprint Magic Keys (HMAC lookup index)
# and to sign the short-lived media grants a key-holder receives.
# Set a long random string and NEVER change it afterwards — every key
# already handed out on paper is bound to it. If unset, a stable
# fallback derived from your deployment is used.
# APP_SECRET="another-long-random-string"

# ── Notes ─────────────────────────────────────────────────────────
# • The FIRST account registered becomes the admin/moderator.
# • Moderation: public capsules are screened against community
#   standards (see src/lib/moderation.ts — the word lists are yours
#   to edit). Three strikes = automatic ban; 3 community reports
#   auto-quarantine a capsule for admin review.
# • To switch to PostgreSQL later: change provider in prisma/schema.prisma
#   to "postgresql", update DATABASE_URL, run `npm run db:push`.
