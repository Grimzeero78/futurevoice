# ─── Future Voices — server configuration ─────────────────────────
# Copy this file to `.env` and adjust. Everything below is optional
# except DATABASE_URL on some hosts; the app runs fine with defaults.

# SQLite database file (created automatically by `npm run db:push`).
# Keep it on a persistent volume/disk and back it up.
DATABASE_URL="file:./db/custom.db"

# Where uploaded media is stored. Must be a writable, persistent path.
# Default: ./uploads next to the project.
# UPLOAD_DIR="/var/lib/future-voices/uploads"

# Public URL of your site — used in verification / reset emails.
# Example: https://capsules.yourdomain.com
# APP_URL="http://localhost:3000"

# ── Email (SMTP) ──────────────────────────────────────────────────
# Configure these to send real verification & password-reset emails.
# Any provider works (Gmail with an App Password, Postmark, SES,
# Resend, Mailgun, your own mail server…). Without them the app still
# works — the links are shown in the interface instead of emailed.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# MAIL_FROM="Future Voices <you@gmail.com>"

# Optional shared secret for the /api/cron endpoint (external scheduler).
# When set, calls must include ?key=<CRON_SECRET>.
# CRON_SECRET="a-long-random-string"

# ── Notes ─────────────────────────────────────────────────────────
# • The FIRST account registered becomes the admin/moderator.
# • To switch to PostgreSQL later: change provider in prisma/schema.prisma
#   to "postgresql", update DATABASE_URL, run `npm run db:push`.
